class Solution {
    public boolean canPlaceFlowers(int[] flowerbed, int n) {

        int m = flowerbed.length;
        boolean ans = false;

        if (n == 0)
            return true;

        if (m == 1 && flowerbed[0] == 0) {
            flowerbed[0] = 1;
            n--;
        }
        else if (m >= 2 && flowerbed[0] == 0 && flowerbed[1] == 0) {
            flowerbed[0] = 1;
            n--;
        }

        if (n > 0 && m >= 2 && flowerbed[m-1] == 0 && flowerbed[m-2] == 0) {
            flowerbed[m-1] = 1;
            n--;
        }

        for (int i = 1; i < m-1; i++) {
            if (n > 0 && flowerbed[i] == 0 &&
                flowerbed[i-1] == 0 && flowerbed[i+1] == 0) {
                flowerbed[i] = 1;
                n--;
            }
        }

        if (n == 0)
            ans = true;

        return ans;
    }
}
