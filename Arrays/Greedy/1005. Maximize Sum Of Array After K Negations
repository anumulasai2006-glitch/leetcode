class Solution {
    public int largestSumAfterKNegations(int[] nums, int k) {

        int n = nums.length;
        int sum = 0;
        Arrays.sort(nums);
        int i = 0;

        while(true) {

            if(k == 0 || i >= n)
                break;

            if(nums[i] >= 0)
                break;

            if(nums[i] < 0) {
                nums[i] = Math.abs(nums[i]);
                k--;
            }

            i++;
        }

        if(k % 2 == 1) {
            Arrays.sort(nums);
            nums[0] = nums[0] * -1;
        }

        for(int j = 0; j < n; j++) {
            sum = sum + nums[j];
        }

        return sum;
    }
}
