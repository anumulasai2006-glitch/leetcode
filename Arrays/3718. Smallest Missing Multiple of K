class Solution {
    public int missingMultiple(int[] nums, int k) {
        Arrays.sort(nums);
        int n = nums.length;
        boolean found = false;
        int ans=k;
        for(int i =0;i<n;i++){
            if(nums[i]==ans){
                found=true;
                ans+=k;
            }            
            else if(found==false && i==n-1){
                   return k;
            }
        }
        return ans;
    }
}
