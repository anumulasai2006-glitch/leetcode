class Solution {
    public int missingNumber(int[] nums) {
        Arrays.sort(nums);
        int n = nums.length;
        int ans = 0;

        if(nums[0]!=0)
        return 0;
        else if(n==1 && nums[0]==0)
        return 1;

        for(int i=0;i<n-1;i++){
            if(nums[i+1]!= nums[i]+1){
                ans=nums[i]+1;
                break;
            } 
            else if(i==n-2){
               return nums[i]+2;
            }
        }

        return ans;   
    }
}
