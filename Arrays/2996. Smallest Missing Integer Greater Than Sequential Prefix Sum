class Solution {
    public int missingInteger(int[] nums) {

        int n = nums.length;
        int sum = nums[0];
        
        boolean found = false;
        for(int i=0;i<n-1;i++){
            if(nums[i+1]==nums[i]+1){
                sum=sum+nums[i+1];
            }
            else{
                break;
            } 
        }
        Arrays.sort(nums);
        for(int i =0;i<n;i++){
            if(nums[i]==sum){
                sum++;
            }
        }
        return sum;
    }
}
