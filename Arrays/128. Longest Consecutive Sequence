class Solution {
    public int longestConsecutive(int[] nums) {
        Arrays.sort(nums);

        int ans = 1;
        int left = 1;
        int n = nums.length;

        if(n == 0)
            return 0;

        if(n == 1)
            return 1;

        for(int i = 1; i < n; i++) {

            if(nums[i] == nums[i - 1])
                continue;

            if(nums[i] == nums[i - 1] + 1) {
                left++;
            } else {
                left = 1;
            }

            ans = Math.max(ans, left);
        }

        return ans;
    }
}
