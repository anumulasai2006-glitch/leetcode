class Solution {
    public int[] rearrangeArray(int[] nums) {

        int n = nums.length;
        int[] posi = new int[n];
        int p = 0;
        int[] negi = new int[n];
        int q=0;

        for(int i = 0;i<n;i++){
            if(nums[i]>0){
                posi[p]=nums[i];
                p++;
            }
            if(nums[i]<0){
                negi[q]=nums[i];
                q++;
            }
        }

        p = 0;
        q = 0;

        for(int i = 0;i<n;i++){
            if(i%2==0){
                nums[i]=posi[p];
                p++;
            }
            else if(i%2!=0){
                nums[i]=negi[q];
                q++;
            }
        }

        return nums;
    }
}
