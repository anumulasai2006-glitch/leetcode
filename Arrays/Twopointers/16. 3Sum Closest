class Solution {
    public int threeSumClosest(int[] nums, int target) {
        
        int n = nums.length;
        int ans = Integer.MAX_VALUE;
        int diff = Integer.MAX_VALUE;
        int sum = 0;

        Arrays.sort(nums);

        for(int i = 0;i < n-1;i++){
            int k = n-1;
            int j = i+1;
            while(j<k){
                sum = nums[i]+nums[j]+nums[k];
                if(sum>target)
                k--;
                else if(sum<target)
                j++;
                else if(sum==target)
                return sum;
                if(diff>Math.abs(target-sum)){
                    diff = Math.abs(target - sum);
                    ans = sum;
                }
            }
        }
        
        return ans;
    }
}
