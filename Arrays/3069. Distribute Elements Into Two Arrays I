class Solution {
    public int[] resultArray(int[] nums) {
        int n=nums.length;
        int[] arr1=new int[n];
        int[] arr2=new int[n];
        int[] ans=new int[n];
        
        arr1[0]=nums[0];
        arr2[0]=nums[1];
        int l1=0;
        int l2=0;

        for(int i=2;i<n;i++){
            if(arr1[l1]>arr2[l2]){
                l1++;
                arr1[l1]=nums[i];   
            }
            else{
                l2++;
                arr2[l2]=nums[i];
            }
        }

        for(int i=0;i<=l1;i++){
            ans[i]=arr1[i];
        }

        int k=0;

        for (int i = l1 + 1; i < n; i++) {
            ans[i] = arr2[k];
            k++;
        }

        return ans;
    }
}
