class Solution {
    public int majorityElement(int[] nums) {
        int n=nums.length;
        int max=0;
        int num=n/2;
        HashMap<Integer,Integer> freq = new HashMap<>();
        for(int i =0;i<n;i++){
            if(!freq.containsKey(nums[i])){
                freq.put(nums[i],1);
            }
            else{
                freq.put(nums[i],freq.get(nums[i])+1);
            }
        }
        for(int i=0;i<n;i++){
            if(freq.get(nums[i])>num)
            max=nums[i];
        }
        return max;
    }
}
