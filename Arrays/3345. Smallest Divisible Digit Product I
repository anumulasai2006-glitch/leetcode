class Solution {
    public int smallestNumber(int n, int t) {

        int num = n;

        while (true) {

            int product = 1;
            int z = num;

            if (z == 0) {
                product = 0;
            } else {
                while (z != 0) {
                    int k = z % 10;
                    product *= k;
                    z /= 10;
                }
            }

            if (product % t == 0)
                return num;

            num++;
        }
    }
}
