class Solution {
    public double findMaxAverage(int[] nums, int k) {
        
        int n = nums.length;
        double ans = 0;
        double sum = 0;

        if(n==1)
        return (double)nums[0]/k;

        for(int i = 0;i<k;i++){
            sum = sum+nums[i];
        }
        
        ans = sum;

        for(int i = k;i<n;i++){
            sum = sum + nums[i] - nums[i-k];
            ans = Math.max(sum,ans);
        }

        ans = ans/k;
        return ans;

    }
}
