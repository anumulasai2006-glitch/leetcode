class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {

        if (n == 1) {
            if (head.next == null) {
                return null;
            }

            ListNode temp2 = head;

            while (temp2.next.next != null) {
                temp2 = temp2.next;
            }

            temp2.next = null;
            return head;
        }

        int num = 0;
        ListNode temp = head;

        while (temp != null) {
            temp = temp.next;
            num++;
        }

        int k = num - n + 1;

        if (k == 1) {
            return head.next;
        }

        ListNode temp1 = head;

        for (int i = 1; i < k - 1; i++) {
            temp1 = temp1.next;
        }

        temp1.next = temp1.next.next;

        return head;
    }
}
