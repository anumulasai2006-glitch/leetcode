class Solution {
    public String largestOddNumber(String num) {
        
        int n = num.length();
        String num1="";
        char c=num.charAt(n-1);
        
        if (c == '1' || c == '3' || c == '5' || c == '7' || c == '9')  
        return num;    
        
        for(int i=0;i<n;i++){
            char k=num.charAt(i);
            if (k == '1' || k == '3' || k == '5' || k == '7' || k == '9')  
            num1=num.substring(0, i+1);
        }

        return num1;
    }
}
