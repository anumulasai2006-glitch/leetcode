class Solution {
    public long sumAndMultiply(int n) {
        String str = String.valueOf(n);
        String num = "";
        int n1 = str.length();
        char[] ch = str.toCharArray();
        long x = 0;

        for (int i = 0; i < n1; i++) {
            if (ch[i] != '0') {
                num = num + ch[i];
                x = x + (ch[i] - '0');
            }
        }

        long number = 0;

        for (int i = 0; i < num.length(); i++) {
            number = number * 10 + (num.charAt(i) - '0');
        }

        long result = number * x;

        return result;
    }
}
