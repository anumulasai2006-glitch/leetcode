class Solution {
    public int[] asteroidCollision(int[] asteroids) {
        
        int n = asteroids.length;
        Stack<Integer> st = new Stack<>();
        int num = 0;
        st.push(asteroids[0]);

        for(int i=1;i<n;i++){
            
            boolean alive=true;

            if(!st.isEmpty())
            num=st.peek();

            while(!st.isEmpty() && num > 0 && asteroids[i] < 0){

                if(Math.abs(num)>Math.abs(asteroids[i])){
                    alive=false;
                    break;
                }
                else if(Math.abs(num)==Math.abs(asteroids[i])){
                    alive=false;
                    st.pop();
                    break;
                }
                else{

                    st.pop();

                    if(!st.isEmpty())
                    num=st.peek();
                }

            }

            if(alive)
            st.push(asteroids[i]);

        }

        int[] ans = new int[st.size()];


        for(int i =st.size()-1;i>=0;i--){
            ans[i]=st.pop();
        }

        return ans;
    }
}
