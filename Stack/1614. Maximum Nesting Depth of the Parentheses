class Solution {
    public int maxDepth(String s) {
        
        int n = s.length();
        int depth = 0;
        int ans = 0;

        Stack<Character> st = new Stack<>();
        
        for(int i=0;i<n;i++){
            if(s.charAt(i)=='('){
                depth++;
                st.push(s.charAt(i));
            }
            else if(s.charAt(i)==')'){
                depth--;
                st.pop();
            }
            ans = Math.max(ans,depth);
        }

        return ans;
    }
}
